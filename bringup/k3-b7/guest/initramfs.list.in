#
# gen_init_cpio list for the K3 B7 guests' embedded initramfs
# (planning/k3-b7-plan.md, Guest software): B6's list with the B7 init.
# scripts/build-guest.sh puts the path of the built init in the /init line.
# Linux execs rdinit= with argv[0] set to the name it was given, so the two
# links select the init's QEMU-only variants (guest/b7-init.c). Kbuild sets
# every mtime to KBUILD_BUILD_TIMESTAMP (usr/Makefile:62-68@v7.2).
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
file /init @B7_GUEST_INIT@ 0755 0 0
slink /init-exit /init 0777 0 0
slink /init-rdcycle /init 0777 0 0
