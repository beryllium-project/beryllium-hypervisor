#
# The K3 B6 guest kernel's Kconfig fragment (planning/k3-b6-plan.md, Guest
# software): platform research section 1b, plus an explicit RISCV_ISA_V=n,
# merged over tinyconfig (allnoconfig with kernel/configs/tiny-base.config
# and kernel/configs/tiny.config) by scripts/kconfig/merge_config.sh -n.
# scripts/build-guest.sh puts the generated gen_init_cpio list in
# INITRAMFS_SOURCE and requires every value below in the final .config.
# MMU=y must be explicit: NONPORTABLE drops PORTABLE, which forced it
# (arch/riscv/Kconfig:1344-1349@v7.2). The initramfs is uncompressed, so no
# compression tool is needed.
# Base ISA, MMU, uniprocessor, no FP or vector state
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
# CONFIG_SMP is not set
CONFIG_NONPORTABLE=y
CONFIG_RISCV_ISA_C=y
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_SBI_V01 is not set
# Embedded initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@B6_INITRAMFS_LIST@"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# Console: printk, TTY, SBI DBCN earlycon and hvc0
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# User space
CONFIG_BINFMT_ELF=y
# Excluded subsystems
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
