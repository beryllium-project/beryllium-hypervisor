diff --git a/mvp/guest/mvp-init.c b/mvp/guest/mvp-init.c
index 980f72b7..f3560649 100644
--- a/mvp/guest/mvp-init.c
+++ b/mvp/guest/mvp-init.c
@@ -198,7 +198,6 @@
 #include <errno.h>
 #include <signal.h>
 #include <stddef.h>
-#include <sys/auxv.h>
 #include <ucontext.h>
 #else
 #include <asm/sigcontext.h>
@@ -313,8 +312,11 @@ typedef void (*__sighandler_t)(int);
  * The kernel's purecap struct ucontext (arch/riscv/include/uapi/asm/
  * ucontext.h) keeps uc_mcontext at offset 0xb0, where a non-CHERI kernel
  * has it, but CHERI Alliance musl's ucontext_t has it at 0xc0 (after its
- * 128-byte sigset_t), so musl's __gregs[REG_PC] is the kernel's ra. The
- * handler uses the kernel's layout: pc is sc_regs' first capability.
+ * 128-byte sigset_t), so musl's __gregs[REG_PC] is the kernel's ra. musl
+ * means a 112-byte sigset_t here, which would agree, but the guard in its
+ * include/alltypes.h.in tests __CHERI_PURE_CAPABILITY, which the compiler
+ * does not define (it defines __CHERI_PURE_CAPABILITY__). The handler
+ * uses the kernel's layout: pc is sc_regs' first capability.
  */
 #define MVP_KERNEL_UC_MCONTEXT	0xb0UL
 _Static_assert(offsetof(ucontext_t, uc_mcontext) == 0xc0UL,
@@ -326,20 +328,6 @@ static long mvp_syscall_result(intptr_t result)
 }
 
 #define _syscall(...)	mvp_syscall_result(syscall(__VA_ARGS__))
-
-/*
- * CHERI Alliance musl's clock_gettime() calls the vDSO through a function
- * capability that __vdsosym (src/internal/vdso.c) derives by arithmetic
- * on uintptr_t; under this kernel it comes back untagged, with its
- * address's low 32 bits sign-extended, and the first call faults.
- * The init asks the kernel directly instead.
- */
-static int mvp_clock_gettime(clockid_t clock, struct timespec *now)
-{
-	return (int)syscall(SYS_clock_gettime, clock, now);
-}
-
-#define clock_gettime(clock, now)	mvp_clock_gettime(clock, now)
 #endif
 _Static_assert(BE_MGMT_IOC_CALL == 0xc0184242UL,
 	       "the management ioctl is be-mgmt.ko's");
@@ -833,24 +821,6 @@ static unsigned long deny_one(const struct mvp_role *role, unsigned long index,
 	return !observed || (store && !unchanged) ? 1UL : 0UL;
 }
 
-#ifdef __CHERI_PURE_CAPABILITY__
-/*
- * beryllium-cheri: under the proof of concept's stack, a page fault taken
- * with the user pc in the vDSO returns to that pc with its low 32 bits
- * sign-extended (cause not established), and the kernel's signal return
- * runs the vDSO's rt_sigreturn trampoline, in the vDSO's first page. So
- * the child reads that page from its own code before it arms its handler,
- * and the trampoline's page is mapped before the trampoline runs.
- */
-static void touch_vdso(void)
-{
-	const volatile char *vdso = getauxptr(AT_SYSINFO_EHDR);
-
-	if (vdso != NULL)
-		(void)vdso[0];
-}
-#endif
-
 /*
  * In the child: each denied access in be.deny's order (deny_one); the
  * number of denials that failed (all of them when the handler cannot be
@@ -861,9 +831,6 @@ static unsigned long make_denials(const struct mvp_role *role)
 {
 	unsigned long index, failures = 0;
 
-#ifdef __CHERI_PURE_CAPABILITY__
-	touch_vdso();
-#endif
 	if (role->denials != 0UL &&
 	    set_segv((__sighandler_t)(void (*)(void))on_segv, SA_SIGINFO) != 0)
 		return role->denials;
