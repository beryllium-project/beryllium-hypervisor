diff --git a/mvp/guest/cheri-kernel.config b/mvp/guest/cheri-kernel.config
new file mode 100644
index 00000000..8a319f9a
--- /dev/null
+++ b/mvp/guest/cheri-kernel.config
@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: GPL-3.0-only
+# Copyright (C) 2026 James Morris <jamorris@linux.microsoft.com>
+#
+# beryllium-cheri: the CHERI guest kernel's own Kconfig fragment
+# (tools/build-guest-cheri.sh), merged after B6's fragment and
+# guest/mvp-kernel.config over tinyconfig. CHERI Alliance Linux offers one
+# CHERI mode on RISC-V: the kernel itself built as purecap code, with the
+# purecap user ABI (arch/Kconfig, CHERI_UABI_AND_KERNEL), so the init,
+# BusyBox, and the management module are purecap too.
+CONFIG_RISCV_CHERI=y
+CONFIG_CHERI_UABI_AND_KERNEL=y
+# The CHERI port's stack walker without frame pointers does not compile
+# (arch/riscv/kernel/stacktrace.c: an int-to-pointer conversion in the
+# !CONFIG_FRAME_POINTER branch); Codasip's own configurations keep them.
+CONFIG_FRAME_POINTER=y
+# Loadable modules cost a CHERI kernel more than a plain one: each
+# exported symbol carries a capability relocation, and the exports cost
+# 530 KiB, which put the Image over the monitor's kernel file budget
+# (BE_MVP_KERNEL_FILE_MAX). Only the management module's six imports stay
+# exported (guest/cheri-ksyms.txt, rendered to its absolute path).
+CONFIG_TRIM_UNUSED_KSYMS=y
+CONFIG_UNUSED_KSYMS_WHITELIST="@CHERI_KSYMS@"
