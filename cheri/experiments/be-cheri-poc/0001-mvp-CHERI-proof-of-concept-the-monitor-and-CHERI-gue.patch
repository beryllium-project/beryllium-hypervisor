diff --git a/mvp/guest/mgmt/be-mgmt.c b/mvp/guest/mgmt/be-mgmt.c
index 120aa732..aa9537d2 100644
--- a/mvp/guest/mgmt/be-mgmt.c
+++ b/mvp/guest/mgmt/be-mgmt.c
@@ -48,8 +48,19 @@ struct be_mgmt_call {
 
 static_assert(BE_MGMT_IOC_CALL == 0xc0184242);
 
+/*
+ * beryllium-cheri: in CHERI Alliance Linux's purecap user ABI an ioctl's
+ * argument is a user capability, user_uintptr_t, which the cast below
+ * keeps whole.
+ */
+#ifdef CONFIG_CHERI_PURECAP_UABI
+typedef user_uintptr_t be_mgmt_arg_t;
+#else
+typedef unsigned long be_mgmt_arg_t;
+#endif
+
 static long be_mgmt_ioctl(struct file *file, unsigned int cmd,
-			  unsigned long arg)
+			  be_mgmt_arg_t arg)
 {
 	void __user *user = (void __user *)arg;
 	struct be_mgmt_call call;
diff --git a/mvp/guest/mvp-init.c b/mvp/guest/mvp-init.c
index 8dd80eed..bfa68054 100644
--- a/mvp/guest/mvp-init.c
+++ b/mvp/guest/mvp-init.c
@@ -194,8 +194,14 @@
 #include <sys/utsname.h>
 #include <sys/wait.h>
 #include <asm/ioctls.h>
+#ifdef __CHERI_PURE_CAPABILITY__
+#include <errno.h>
+#include <signal.h>
+#include <ucontext.h>
+#else
 #include <asm/sigcontext.h>
 #include <asm/ucontext.h>
+#endif
 #include <linux/ioctl.h>
 #include <linux/reboot.h>
 #include <linux/types.h>
@@ -204,7 +210,12 @@
 #include "mvp-sha256.h"
 
 /* The pinned guest kernel (Linux v7.2), and the plan's steps and sleep. */
+#ifdef __CHERI_PURE_CAPABILITY__
+/* beryllium-cheri: the CHERI guest's kernel is CHERI Alliance Linux v7.1. */
+#define EXPECTED_RELEASE	"7.1.0"
+#else
 #define EXPECTED_RELEASE	"7.2.0"
+#endif
 #define EXPECTED_MACHINE	"riscv64"
 #define STEPS			8UL
 #define STEP_COMPUTE_NS		25000000UL
@@ -283,7 +294,45 @@ struct be_mgmt_call {
 
 #define BE_MGMT_IOC_CALL	_IOWR('B', 0x42, struct be_mgmt_call)
 
+#ifndef __CHERI_PURE_CAPABILITY__
 _Static_assert(sizeof(sigset_t) == SIGSET_BYTES, "sigset_t is one word");
+#else
+/*
+ * beryllium-cheri: the CHERI guest's init is a purecap program against the
+ * CHERI Alliance musl, not nolibc. nolibc's _syscall(), its syscall()
+ * without the errno conversion (0 or more, or a negative errno), is musl's
+ * syscall(), whose macro passes every argument as a capability-sized word,
+ * converted back; and SIGSEGV's action goes through musl's sigaction(),
+ * since the kernel's purecap struct sigaction is not nolibc's (set_segv).
+ */
+typedef void (*__sighandler_t)(int);
+
+/* musl's mcontext index of pc, which it names only for _GNU_SOURCE. */
+#ifndef REG_PC
+#define REG_PC	0
+#endif
+
+static long mvp_syscall_result(intptr_t result)
+{
+	return (long)result < 0 ? -(long)errno : (long)result;
+}
+
+#define _syscall(...)	mvp_syscall_result(syscall(__VA_ARGS__))
+
+/*
+ * CHERI Alliance musl's clock_gettime() calls the vDSO through a function
+ * capability that __vdsosym (src/internal/vdso.c) derives by arithmetic
+ * on uintptr_t; under this kernel it comes back untagged, with its
+ * address's low 32 bits sign-extended, and the first call faults.
+ * The init asks the kernel directly instead.
+ */
+static int mvp_clock_gettime(clockid_t clock, struct timespec *now)
+{
+	return (int)syscall(SYS_clock_gettime, clock, now);
+}
+
+#define clock_gettime(clock, now)	mvp_clock_gettime(clock, now)
+#endif
 _Static_assert(BE_MGMT_IOC_CALL == 0xc0184242UL,
 	       "the management ioctl is be-mgmt.ko's");
 
@@ -652,19 +701,33 @@ static long set_segv(__sighandler_t handler, unsigned long flags)
 
 	memset(&action, 0, sizeof(action));
 	action.sa_handler = handler;
+#ifdef __CHERI_PURE_CAPABILITY__
+	action.sa_flags = (int)flags;
+	return sigaction(SIGSEGV, &action, NULL) == 0 ? 0 : -(long)errno;
+#else
 	action.sa_flags = flags;
 	return _syscall(__NR_rt_sigaction, SIGSEGV, &action, NULL, SIGSET_BYTES);
+#endif
 }
 
 /*
  * The handler: record the signal; step over the armed instruction alone,
  * on its first fault. Any other fault restores the default action, so the
  * instruction faults again and ends the child.
+ *
+ * beryllium-cheri: in the purecap init, the ucontext's pc is a capability
+ * (musl's __gregs[REG_PC]); its address is compared, and the step adds 4
+ * to the capability itself, which keeps it valid.
  */
 static void on_segv(int signo, siginfo_t *info, void *context)
 {
+#ifdef __CHERI_PURE_CAPABILITY__
+	ucontext_t *frame = context;
+	unsigned long pc = (unsigned long)frame->uc_mcontext.__gregs[REG_PC];
+#else
 	struct ucontext *frame = context;
 	unsigned long pc = frame->uc_mcontext.sc_regs.pc;
+#endif
 
 	seen_count = seen_count + 1UL;
 	seen_signo = info->si_signo;
@@ -672,7 +735,11 @@ static void on_segv(int signo, siginfo_t *info, void *context)
 	seen_addr = (unsigned long)info->si_addr;
 	seen_pc = pc;
 	if (signo == SIGSEGV && pc == armed_pc && seen_count == 1UL)
+#ifdef __CHERI_PURE_CAPABILITY__
+		frame->uc_mcontext.__gregs[REG_PC] += 4;
+#else
 		frame->uc_mcontext.sc_regs.pc = pc + 4UL;
+#endif
 	else
 		(void)set_segv(SIG_DFL, 0UL);
 }
