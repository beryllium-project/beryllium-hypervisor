#
# The CHERI test guest kernel's own Kconfig fragment, merged after
# Beryllium's B6 guest fragment (bringup/k3-b6/guest/b6-kernel.config) over
# tinyconfig, as Beryllium builds its guest kernel. CHERI Alliance Linux
# offers one CHERI mode on RISC-V: the kernel itself built as purecap code,
# with the purecap user ABI (arch/Kconfig, CHERI_UABI_AND_KERNEL), so its
# user space must be purecap too.
CONFIG_RISCV_CHERI=y
CONFIG_CHERI_UABI_AND_KERNEL=y
# The CHERI port's stack walker without frame pointers does not compile
# (arch/riscv/kernel/stacktrace.c: an int-to-pointer conversion in the
# !CONFIG_FRAME_POINTER branch); Codasip's own configurations keep them.
CONFIG_FRAME_POINTER=y
