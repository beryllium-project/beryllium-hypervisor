	case BE_R5_ERROR_CAUSE:
		return "cause";
	case BE_R5_ERROR_PC:
		return "pc";
	case BE_R5_ERROR_GVA:
		return "gva";
	case BE_R5_ERROR_HTVAL_OVERFLOW:
		return "htval-overflow";
	case BE_R5_ERROR_GPA:
		return "gpa";
	case BE_R5_ERROR_TRAP_METADATA:
		return "trap-metadata";
	case BE_R5_ERROR_EVENT_ARGS:
