/* SPDX-License-Identifier: GPL-3.0-only */
/*
 * Copyright (C) 2026 James Morris <jamorris@linux.microsoft.com>
 *
 * Purpose: R5 trusted-stack VS-exit vector, complete fixed-frame transfer,
 *          checked root installation and fence, target reset/readback, and the
 *          two no-call SRET tails.
 * Trust:   sole HS frame/CSR transition boundary. It never dereferences a
 *          guest address, never selects monitor storage from a guest value,
 *          and never writes a G-stage page-table entry.
 * Scope:   management -> protected -> management only. There is no rollback,
 *          alternate target, source fallback, or re-entry after failure.
 */

	.attribute arch, "rv64imach_zicsr_zifencei"
	.option norvc

	.equ R5_HSTATUS_CONTROL_MASK, 0x000000000073f380
	.equ R5_HSTATUS_CONTROL_VALUE, 0x0000000000700180
	.equ R5_HSTATUS_SPV, 0x80
	.equ R5_HSTATUS_SPVP, 0x100
	/* BE_R3_SSTATUS_CONTROL_MASK; non-control WARL fields may read nonzero. */
	.equ R5_SSTATUS_CONTROL_MASK, 0x00000000000de122
	.equ R5_SSTATUS_SPP, 0x100

	/*
	 * Keep these in lockstep with enum be_r5_error.  Assembly can reach
	 * terminal reporting only after a transition failure, so its values
	 * must retain the C-visible stable error identity.  r5-runtime.c
	 * asserts each of them against the enumeration at build time.
	 */
	.equ R5_ERROR_INVALID_PHASE, 2
	.equ R5_ERROR_TRUSTED_STACK, 6
	.equ R5_ERROR_HGATP, 8
	.equ R5_ERROR_VS_ORIGIN, 9
	.equ R5_ERROR_ENTRY_CONTROLS, 16

	/* struct be_r3_hs_state offsets; R3 validates this initial readback. */
	.equ HS_SATP, 0
	.equ HS_SSTATUS, 8
	.equ HS_STVEC, 16
	.equ HS_SSCRATCH, 24
	.equ HS_SEPC, 32
	.equ HS_SCAUSE, 40
	.equ HS_STVAL, 48
	.equ HS_SIE, 56
	.equ HS_SIP, 64
	.equ HS_SENVCFG, 72
	.equ HS_SCOUNTEREN, 80
	.equ HS_HSTATUS, 88
	.equ HS_HEDELEG, 96
	.equ HS_HIDELEG, 104
	.equ HS_HIE, 112
	.equ HS_HIP, 120
	.equ HS_HVIP, 128
	.equ HS_HCOUNTEREN, 136
	.equ HS_HTIMEDELTA, 144
	.equ HS_HENVCFG, 152
	.equ HS_HGEIE, 160
	.equ HS_HGEIP, 168
	.equ HS_HTVAL, 176
	.equ HS_HGATP, 184
	.equ HS_VSSTATUS, 192
	.equ HS_VSIE, 200
	.equ HS_VSTVEC, 208
	.equ HS_VSSCRATCH, 216
	.equ HS_VSEPC, 224
	.equ HS_VSCAUSE, 232
	.equ HS_VSTVAL, 240
	.equ HS_VSIP, 248
	.equ HS_VSATP, 256

	/* struct be_r4_frame offsets; the frame is unchanged from accepted R4. */
	.equ FR_VSTVEC, 248
	.equ FR_VSEPC, 256
	.equ FR_VSCAUSE, 264
	.equ FR_VSTVAL, 272
	.equ FR_SCAUSE, 280
	.equ FR_SEPC, 288
	.equ FR_STVAL, 296
	.equ FR_HTVAL, 304
	.equ FR_RESERVED, 312

	/* struct be_r5_controls offsets. */
	.equ CTL_HGATP, 0
	.equ CTL_HSTATUS, 8
	.equ CTL_VSATP, 16
	.equ CTL_SSCRATCH, 24

	/* struct be_r5_fence_ack offsets. */
	.equ ACK_SOURCE_HGATP, 0
	.equ ACK_HGATP_WRITTEN, 8
	.equ ACK_HGATP_READBACK, 16
	.equ ACK_VIRTUALIZATION_OFF, 24
	.equ ACK_FENCE_COMPLETED, 28

	/* struct be_r5_entry_state offsets. */
	.equ EN_HGATP, 0
	.equ EN_HSTATUS, 8
	.equ EN_SSTATUS, 16
	.equ EN_VSATP, 24
	.equ EN_VSTVEC, 32
	.equ EN_VSEPC, 40
	.equ EN_VSCAUSE, 48
	.equ EN_VSTVAL, 56
	.equ EN_TRUSTED_SP, 64
	.equ EN_SAVED_STATE_PA, 72

	.section .text, "ax"
	.align 4
	.globl be_r5_arch_reset_state
	.type be_r5_arch_reset_state, @function
be_r5_arch_reset_state:
	/* Initial reset is R3-equivalent except that R5 owns the direct vector. */
	csrw satp, zero
	sfence.vma zero, zero
	csrw sstatus, zero
	csrw stvec, a0
	csrw sscratch, zero
	csrw sepc, zero
	csrw scause, zero
	csrw stval, zero
	csrw sie, zero
	csrw senvcfg, zero
	csrw scounteren, zero
	.option push
	.option arch, +h
	csrr t0, hstatus
	li t1, R5_HSTATUS_CONTROL_MASK
	not t1, t1
	and t0, t0, t1
	li t1, R5_HSTATUS_CONTROL_VALUE
	or t0, t0, t1
	csrw hstatus, t0
	csrw hedeleg, zero
	csrw hideleg, zero
	csrw hie, zero
	csrw hvip, zero
	csrw hcounteren, zero
	csrw htimedelta, zero
	csrw henvcfg, zero
	csrw hgeie, zero
	csrw htval, zero
	csrw hgatp, zero
	hfence.gvma zero, zero
	csrw vsstatus, zero
	csrw vsie, zero
	csrw vstvec, zero
	csrw vsscratch, zero
	csrw vsepc, zero
	csrw vscause, zero
	csrw vstval, zero
	csrw vsip, zero
	csrw vsatp, zero
	csrr t0, satp
	sd t0, HS_SATP(a1)
	csrr t0, sstatus
	sd t0, HS_SSTATUS(a1)
	csrr t0, stvec
	sd t0, HS_STVEC(a1)
	csrr t0, sscratch
	sd t0, HS_SSCRATCH(a1)
	csrr t0, sepc
	sd t0, HS_SEPC(a1)
	csrr t0, scause
	sd t0, HS_SCAUSE(a1)
	csrr t0, stval
	sd t0, HS_STVAL(a1)
	csrr t0, sie
	sd t0, HS_SIE(a1)
	csrr t0, sip
	sd t0, HS_SIP(a1)
	csrr t0, senvcfg
	sd t0, HS_SENVCFG(a1)
	csrr t0, scounteren
	sd t0, HS_SCOUNTEREN(a1)
	csrr t0, hstatus
	sd t0, HS_HSTATUS(a1)
	csrr t0, hedeleg
	sd t0, HS_HEDELEG(a1)
	csrr t0, hideleg
	sd t0, HS_HIDELEG(a1)
	csrr t0, hie
	sd t0, HS_HIE(a1)
	csrr t0, hip
	sd t0, HS_HIP(a1)
	csrr t0, hvip
	sd t0, HS_HVIP(a1)
	csrr t0, hcounteren
	sd t0, HS_HCOUNTEREN(a1)
	csrr t0, htimedelta
	sd t0, HS_HTIMEDELTA(a1)
	csrr t0, henvcfg
	sd t0, HS_HENVCFG(a1)
	csrr t0, hgeie
	sd t0, HS_HGEIE(a1)
	csrr t0, hgeip
	sd t0, HS_HGEIP(a1)
	csrr t0, htval
	sd t0, HS_HTVAL(a1)
	csrr t0, hgatp
	sd t0, HS_HGATP(a1)
	csrr t0, vsstatus
	sd t0, HS_VSSTATUS(a1)
	csrr t0, vsie
	sd t0, HS_VSIE(a1)
	csrr t0, vstvec
	sd t0, HS_VSTVEC(a1)
	csrr t0, vsscratch
	sd t0, HS_VSSCRATCH(a1)
	csrr t0, vsepc
	sd t0, HS_VSEPC(a1)
	csrr t0, vscause
	sd t0, HS_VSCAUSE(a1)
	csrr t0, vstval
	sd t0, HS_VSTVAL(a1)
	csrr t0, vsip
	sd t0, HS_VSIP(a1)
	csrr t0, vsatp
	sd t0, HS_VSATP(a1)
	.option pop
	ret
	.size be_r5_arch_reset_state, . - be_r5_arch_reset_state

	.align 4
	.globl be_r5_trap_vector
	.type be_r5_trap_vector, @function
be_r5_trap_vector:
	/* First instruction exchanges untrusted guest sp before any stack access. */
	csrrw sp, sscratch, sp
	csrw sie, zero
	.option push
	.option arch, +h
	csrw hie, zero
	csrw hvip, zero
	.option pop
	/*
	 * The trusted-stack top is exclusive but not writable. Reserve a
	 * 16-byte-aligned spill frame before preserving t0/t1 for frame setup.
	 */
	addi sp, sp, -16
	sd t0, 0(sp)
	sd t1, 8(sp)
	/*
	 * The monitor saved page is selected from the checked trusted-stack
	 * identity alone.  A stack that is neither exclusively owned extent is
	 * terminal: no guest value may ever name monitor storage.
	 */
	addi t0, sp, 16
	la t1, __be_stack_management_end
	beq t0, t1, 1f
	la t1, __be_stack_protected_end
	bne t0, t1, .Lbad_stack
	la t0, __be_saved_protected_start
	j 2f
1:
	la t0, __be_saved_management_start
2:
	sd ra, 0(t0)
	csrr t1, sscratch
	sd t1, 8(t0)
	/*
	 * sscratch must again name trusted storage before C is reachable: a
	 * nested or partial HS trap then cannot exchange onto guest memory.
	 */
	addi t1, sp, 16
	csrw sscratch, t1
	sd gp, 16(t0)
	sd tp, 24(t0)
	ld t1, 0(sp)
	sd t1, 32(t0)
	ld t1, 8(sp)
	sd t1, 40(t0)
	sd t2, 48(t0)
	sd s0, 56(t0)
	sd s1, 64(t0)
	sd a0, 72(t0)
	sd a1, 80(t0)
	sd a2, 88(t0)
	sd a3, 96(t0)
	sd a4, 104(t0)
	sd a5, 112(t0)
	sd a6, 120(t0)
	sd a7, 128(t0)
	sd s2, 136(t0)
	sd s3, 144(t0)
	sd s4, 152(t0)
	sd s5, 160(t0)
	sd s6, 168(t0)
	sd s7, 176(t0)
	sd s8, 184(t0)
	sd s9, 192(t0)
	sd s10, 200(t0)
	sd s11, 208(t0)
	sd t3, 216(t0)
	sd t4, 224(t0)
	sd t5, 232(t0)
	sd t6, 240(t0)
	.option push
	.option arch, +h
	csrr t1, vstvec
	sd t1, FR_VSTVEC(t0)
	csrr t1, vsepc
	sd t1, FR_VSEPC(t0)
	csrr t1, vscause
	sd t1, FR_VSCAUSE(t0)
	csrr t1, vstval
	sd t1, FR_VSTVAL(t0)
	csrr t1, scause
	sd t1, FR_SCAUSE(t0)
	csrr t1, sepc
	sd t1, FR_SEPC(t0)
	csrr t1, stval
	sd t1, FR_STVAL(t0)
	csrr t1, htval
	sd t1, FR_HTVAL(t0)
	sd zero, FR_RESERVED(t0)
	csrr t1, hstatus
	li t2, R5_HSTATUS_SPV | R5_HSTATUS_SPVP
	and t1, t1, t2
	bne t1, t2, .Lbad_origin
	.option pop
	/* C is entered with monitor values only; no guest GPR is live. */
	mv a0, t0
	call be_r5_trap_dispatch
	/* The dispatch is terminal or tail-calls a no-call restore tail. */
	li a0, R5_ERROR_INVALID_PHASE
	tail be_r5_runtime_terminal

.Lbad_stack:
	la sp, __be_stack_management_end
	li a0, R5_ERROR_TRUSTED_STACK
	tail be_r5_runtime_terminal

.Lbad_origin:
	li a0, R5_ERROR_VS_ORIGIN
	tail be_r5_runtime_terminal
	.size be_r5_trap_vector, . - be_r5_trap_vector

	.align 4
	.globl be_r5_arch_read_controls
	.type be_r5_arch_read_controls, @function
be_r5_arch_read_controls:
	.option push
	.option arch, +h
	csrr t0, hgatp
	sd t0, CTL_HGATP(a0)
	csrr t0, hstatus
	sd t0, CTL_HSTATUS(a0)
	csrr t0, vsatp
	sd t0, CTL_VSATP(a0)
	.option pop
	csrr t0, sscratch
	sd t0, CTL_SSCRATCH(a0)
	ret
	.size be_r5_arch_read_controls, . - be_r5_arch_read_controls

	.align 4
	.globl be_r5_arch_install_root
	.type be_r5_arch_install_root, @function
be_r5_arch_install_root:
	/*
	 * This exact order is load-bearing: record the source root, write the
	 * unpublished target root, execute the local all-GPA/all-VMID fence,
	 * then read back.  No page-table entry is written here or anywhere in
	 * R5: both roots remain immutable R2 products.
	 */
	.option push
	.option arch, +h
	csrr t0, hgatp
	sd t0, ACK_SOURCE_HGATP(a0)
	/*
	 * hgatp is HS-only.  Retiring this write instead of taking a virtual
	 * instruction trap is what establishes that V was zero.
	 */
	csrw hgatp, a1
	sd a1, ACK_HGATP_WRITTEN(a0)
	li t1, 1
	sw t1, ACK_VIRTUALIZATION_OFF(a0)
	hfence.gvma zero, zero
	sw t1, ACK_FENCE_COMPLETED(a0)
	csrr t0, hgatp
	sd t0, ACK_HGATP_READBACK(a0)
	.option pop
	ret
	.size be_r5_arch_install_root, . - be_r5_arch_install_root

	.align 4
	.globl be_r5_arch_reset_target
	.type be_r5_arch_reset_target, @function
be_r5_arch_reset_target:
	mv t3, a0
	mv t4, a1
	/* Derive the target saved page from the fixed trusted-stack identity. */
	la t5, __be_stack_management_end
	beq t4, t5, 1f
	la t5, __be_stack_protected_end
	bne t4, t5, .Lreset_bad_stack
	la t5, __be_saved_protected_start
	j 2f
1:
	la t5, __be_saved_management_start
2:
	csrw satp, zero
	sfence.vma zero, zero
	csrw sstatus, zero
	la t0, be_r5_trap_vector
	csrw stvec, t0
	csrw sscratch, t4
	csrw sepc, zero
	csrw scause, zero
	csrw stval, zero
	csrw sie, zero
	csrw senvcfg, zero
	csrw scounteren, zero
	.option push
	.option arch, +h
	csrr t0, hstatus
	li t1, R5_HSTATUS_CONTROL_MASK
	not t1, t1
	and t0, t0, t1
	li t1, R5_HSTATUS_CONTROL_VALUE
	or t0, t0, t1
	csrw hstatus, t0
	csrw hedeleg, zero
	csrw hideleg, zero
	csrw hie, zero
	csrw hvip, zero
	csrw hcounteren, zero
	csrw htimedelta, zero
	csrw henvcfg, zero
	csrw hgeie, zero
	csrw htval, zero
	/* hgatp was installed and fenced already and is never rewritten here. */
	csrw vsstatus, zero
	csrw vsie, zero
	csrw vstvec, zero
	csrw vsscratch, zero
	csrw vsepc, zero
	csrw vscause, zero
	csrw vstval, zero
	csrw vsip, zero
	csrw vsatp, zero
	/* Read back every writable R-disposition control before publication. */
	csrr t0, satp
	bnez t0, .Lreset_bad_controls
	csrr t0, sstatus
	li t1, R5_SSTATUS_CONTROL_MASK
	and t0, t0, t1
	bnez t0, .Lreset_bad_controls
	csrr t0, stvec
	la t1, be_r5_trap_vector
	bne t0, t1, .Lreset_bad_controls
	csrr t0, sscratch
	bne t0, t4, .Lreset_bad_stack
	csrr t0, sie
	bnez t0, .Lreset_bad_controls
	csrr t0, senvcfg
	bnez t0, .Lreset_bad_controls
	csrr t0, scounteren
	bnez t0, .Lreset_bad_controls
	csrr t0, hedeleg
	bnez t0, .Lreset_bad_controls
	csrr t0, hideleg
	bnez t0, .Lreset_bad_controls
	csrr t0, hie
	bnez t0, .Lreset_bad_controls
	csrr t0, hvip
	bnez t0, .Lreset_bad_controls
	csrr t0, hcounteren
	bnez t0, .Lreset_bad_controls
	csrr t0, htimedelta
	bnez t0, .Lreset_bad_controls
	csrr t0, henvcfg
	bnez t0, .Lreset_bad_controls
	csrr t0, hgeie
	bnez t0, .Lreset_bad_controls
	csrr t0, htval
	bnez t0, .Lreset_bad_controls
	csrr t0, vsstatus
	li t1, R5_SSTATUS_CONTROL_MASK
	and t0, t0, t1
	bnez t0, .Lreset_bad_controls
	csrr t0, vsie
	bnez t0, .Lreset_bad_controls
	csrr t0, vsscratch
	bnez t0, .Lreset_bad_controls
	csrr t0, vsip
	bnez t0, .Lreset_bad_controls
	.option pop
	/* SPP is the only control the target entry state may carry. */
	li t0, R5_SSTATUS_SPP
	csrs sstatus, t0
	.option push
	.option arch, +h
	csrr t0, hgatp
	sd t0, EN_HGATP(t3)
	csrr t0, hstatus
	sd t0, EN_HSTATUS(t3)
	csrr t0, vsatp
	sd t0, EN_VSATP(t3)
	csrr t0, vstvec
	sd t0, EN_VSTVEC(t3)
	csrr t0, vsepc
	sd t0, EN_VSEPC(t3)
	csrr t0, vscause
	sd t0, EN_VSCAUSE(t3)
	csrr t0, vstval
	sd t0, EN_VSTVAL(t3)
	.option pop
	csrr t0, sstatus
	sd t0, EN_SSTATUS(t3)
	csrr t0, sscratch
	sd t0, EN_TRUSTED_SP(t3)
	sd t5, EN_SAVED_STATE_PA(t3)
	ret

.Lreset_bad_stack:
	li a0, R5_ERROR_TRUSTED_STACK
	tail be_r5_runtime_terminal

.Lreset_bad_controls:
	li a0, R5_ERROR_ENTRY_CONTROLS
	tail be_r5_runtime_terminal
	.size be_r5_arch_reset_target, . - be_r5_arch_reset_target

	.align 4
	.globl be_r5_arch_restore_active
	.type be_r5_arch_restore_active, @function
be_r5_arch_restore_active:
	/* Reset all R-disposition controls; deliberately do not write HGATP. */
	mv t6, a0
	mv t5, a1
	mv t4, a2
	la t0, __be_root_protected_start
	csrw satp, zero
	sfence.vma zero, zero
	csrw sstatus, zero
	la t0, be_r5_trap_vector
	csrw stvec, t0
	csrw sscratch, t4
	csrw sepc, zero
	csrw scause, zero
	csrw stval, zero
	csrw sie, zero
	csrw senvcfg, zero
	csrw scounteren, zero
	.option push
	.option arch, +h
	csrr t0, hstatus
	li t1, R5_HSTATUS_CONTROL_MASK
	not t1, t1
	and t0, t0, t1
	li t1, R5_HSTATUS_CONTROL_VALUE
	or t0, t0, t1
	csrw hstatus, t0
	csrw hedeleg, zero
	csrw hideleg, zero
	csrw hie, zero
	csrw hvip, zero
	csrw hcounteren, zero
	csrw htimedelta, zero
	csrw henvcfg, zero
	csrw hgeie, zero
	csrw htval, zero
	csrw vsstatus, zero
	csrw vsie, zero
	csrw vstvec, zero
	csrw vsscratch, zero
	csrw vsepc, zero
	csrw vscause, zero
	csrw vstval, zero
	csrw vsip, zero
	csrw vsatp, zero
	/* Read back every writable R-disposition control before frame restore. */
	csrr t0, satp
	bnez t0, .Lrestore_bad_controls
	csrr t0, sstatus
	li t1, R5_SSTATUS_CONTROL_MASK
	and t0, t0, t1
	bnez t0, .Lrestore_bad_controls
	csrr t0, stvec
	la t1, be_r5_trap_vector
	bne t0, t1, .Lrestore_bad_controls
	csrr t0, sscratch
	bne t0, t4, .Lrestore_bad_stack
	csrr t0, sie
	bnez t0, .Lrestore_bad_controls
	csrr t0, senvcfg
	bnez t0, .Lrestore_bad_controls
	csrr t0, scounteren
	bnez t0, .Lrestore_bad_controls
	csrr t0, hstatus
	li t1, R5_HSTATUS_CONTROL_MASK
	and t0, t0, t1
	li t1, R5_HSTATUS_CONTROL_VALUE
	bne t0, t1, .Lrestore_bad_controls
	csrr t0, hedeleg
	bnez t0, .Lrestore_bad_controls
	csrr t0, hideleg
	bnez t0, .Lrestore_bad_controls
	csrr t0, hie
	bnez t0, .Lrestore_bad_controls
	csrr t0, hvip
	bnez t0, .Lrestore_bad_controls
	csrr t0, hcounteren
	bnez t0, .Lrestore_bad_controls
	csrr t0, htimedelta
	bnez t0, .Lrestore_bad_controls
	csrr t0, henvcfg
	bnez t0, .Lrestore_bad_controls
	csrr t0, hgeie
	bnez t0, .Lrestore_bad_controls
	csrr t0, htval
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsstatus
	li t1, R5_SSTATUS_CONTROL_MASK
	and t0, t0, t1
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsie
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsscratch
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsip
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsatp
	bnez t0, .Lrestore_bad_controls
	/* The unchanged active root must still be the selected root. */
	csrr t0, hgatp
	bne t0, t5, .Lrestore_bad_hgatp
	ld t0, FR_VSTVEC(t6)
	csrw vstvec, t0
	ld t0, FR_VSEPC(t6)
	csrw vsepc, t0
	ld t0, FR_VSCAUSE(t6)
	csrw vscause, t0
	ld t0, FR_VSTVAL(t6)
	csrw vstval, t0
	/*
	 * The frozen matrix classifies these as S fields.  Restore exactly the
	 * saved values; frame.sepc was deliberately advanced by C on success.
	 */
	ld t0, FR_SCAUSE(t6)
	csrw scause, t0
	ld t0, FR_SEPC(t6)
	csrw sepc, t0
	ld t0, FR_STVAL(t6)
	csrw stval, t0
	ld t0, FR_HTVAL(t6)
	csrw htval, t0
	.option pop
	j be_r5_enter_guest_tail

.Lrestore_bad_stack:
	li a0, R5_ERROR_TRUSTED_STACK
	tail be_r5_runtime_terminal

.Lrestore_bad_controls:
	li a0, R5_ERROR_ENTRY_CONTROLS
	tail be_r5_runtime_terminal

.Lrestore_bad_hgatp:
	li a0, R5_ERROR_HGATP
	tail be_r5_runtime_terminal
	.size be_r5_arch_restore_active, . - be_r5_arch_restore_active

	.align 4
	.globl be_r5_switch_tail
	.type be_r5_switch_tail, @function
be_r5_switch_tail:
	/*
	 * Published no-call tail.  The prepared target state was already reset,
	 * read back, and published, so this only verifies it, restores the
	 * complete frame, and executes SRET.  Any trap here is terminal.
	 */
	mv t6, a0
	mv t5, a1
	mv t4, a2
	csrr t0, satp
	bnez t0, .Lrestore_bad_controls
	csrr t0, sstatus
	li t1, R5_SSTATUS_CONTROL_MASK
	and t0, t0, t1
	li t1, R5_SSTATUS_SPP
	bne t0, t1, .Lrestore_bad_controls
	csrr t0, stvec
	la t1, be_r5_trap_vector
	bne t0, t1, .Lrestore_bad_controls
	csrr t0, sscratch
	bne t0, t4, .Lrestore_bad_stack
	csrr t0, sie
	bnez t0, .Lrestore_bad_controls
	csrr t0, scounteren
	bnez t0, .Lrestore_bad_controls
	.option push
	.option arch, +h
	csrr t0, hstatus
	li t1, R5_HSTATUS_CONTROL_MASK
	and t0, t0, t1
	li t1, R5_HSTATUS_CONTROL_VALUE
	bne t0, t1, .Lrestore_bad_controls
	csrr t0, hie
	bnez t0, .Lrestore_bad_controls
	csrr t0, hvip
	bnez t0, .Lrestore_bad_controls
	csrr t0, vsatp
	bnez t0, .Lrestore_bad_controls
	csrr t0, hgatp
	bne t0, t5, .Lrestore_bad_hgatp
	ld t0, FR_VSTVEC(t6)
	csrw vstvec, t0
	ld t0, FR_VSEPC(t6)
	csrw vsepc, t0
	ld t0, FR_VSCAUSE(t6)
	csrw vscause, t0
	ld t0, FR_VSTVAL(t6)
	csrw vstval, t0
	ld t0, FR_SCAUSE(t6)
	csrw scause, t0
	ld t0, FR_SEPC(t6)
	csrw sepc, t0
	ld t0, FR_STVAL(t6)
	csrw stval, t0
	ld t0, FR_HTVAL(t6)
	csrw htval, t0
	.option pop
	j be_r5_enter_guest_tail
	.size be_r5_switch_tail, . - be_r5_switch_tail

	/*
	 * Shared no-call entry tail.  It calls nothing, branches nowhere else,
	 * sets the return privilege before restoring x6, and ends in the single
	 * R5 SRET; t6 remains the monitor frame pointer to the last load.
	 */
	.align 4
	.type be_r5_enter_guest_tail, @function
be_r5_enter_guest_tail:
	li t1, R5_SSTATUS_SPP
	csrs sstatus, t1
	/* Restore all guest registers while retaining t6 as the frame pointer. */
	ld ra, 0(t6)
	ld gp, 16(t6)
	ld tp, 24(t6)
	ld t0, 32(t6)
	ld t1, 40(t6)
	ld t2, 48(t6)
	ld s0, 56(t6)
	ld s1, 64(t6)
	ld a0, 72(t6)
	ld a1, 80(t6)
	ld a2, 88(t6)
	ld a3, 96(t6)
	ld a4, 104(t6)
	ld a5, 112(t6)
	ld a6, 120(t6)
	ld a7, 128(t6)
	ld s2, 136(t6)
	ld s3, 144(t6)
	ld s4, 152(t6)
	ld s5, 160(t6)
	ld s6, 168(t6)
	ld s7, 176(t6)
	ld s8, 184(t6)
	ld s9, 192(t6)
	ld s10, 200(t6)
	ld s11, 208(t6)
	ld t3, 216(t6)
	ld t4, 224(t6)
	ld t5, 232(t6)
	ld sp, 8(t6)
	ld t6, 240(t6)
	sret
	.size be_r5_enter_guest_tail, . - be_r5_enter_guest_tail

	.align 4
	.globl be_r5_arch_halt
	.type be_r5_arch_halt, @function
be_r5_arch_halt:
	csrw sie, zero
	.option push
	.option arch, +h
	csrw hie, zero
	csrw hvip, zero
	.option pop
1:
	wfi
	j 1b
	.size be_r5_arch_halt, . - be_r5_arch_halt
