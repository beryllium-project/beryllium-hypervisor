      "recovery-manifest-v1.json",
      "checksums.sha256"
    ],
    "fixed_report": "results/kvm0-qualification-report-v1.json",
    "fixed_checksum": "checksums.sha256",
    "allowed_prefixes": [
      "artifacts/",
      "captures/",
      "logs/",
      "results/"
    ],
    "allowed_regular_modes": [
      "0600",
      "0644",
      "0755"
    ],
    "top_level_mode": "0644",
    "report_mode": "0644",
    "directory_modes": [
      "0700",
      "0755"
    ],
    "allowed_executable_prefixes": [
      "artifacts/"
    ],
    "member_type": "regular",
    "path_order": "raw-utf8-byte"
  },
  "limits": {
    "total_expanded_bytes": 4294967296,
    "raw_serial_bytes": 134217728,
    "canonical_serial_bytes": 536870912,
    "command_log_bytes": 33554432,
    "manifest_or_report_bytes": 4194304,
    "member_count": 4096,
    "path_bytes": 512
  },
  "checksums": {
    "algorithm": "sha256",
    "hash_pattern": "^[0-9a-f]{64}$",
    "separator": "two-ascii-spaces",
    "line_ending": "LF",
    "order": "raw-utf8-byte",
    "coverage": "every-retained-regular-member-except-checksums.sha256",
    "report_included": true,
    "checksum_self_entry": "forbidden",
    "archive_digest_member": "forbidden",
    "report_digest_field": "forbidden",
    "checksum_digest_field": "forbidden",
    "external_archive_digest": "external-record-only"
  },
