      "schema",
      "approval_state",
      "bundle_id",
      "archive_sha256",
      "archive_byte_size",
      "checksums_sha256",
      "source_commit",
      "source_tree",
      "members"
    ]
  },
  "members": {
    "mandatory_top_level": [
      "bundle-manifest-v1.json",
      "source-manifest-v1.json",
      "patch-manifest-v1.json",
      "tool-manifest-v1.json",
      "firmware-manifest-v1.json",
