# Self-contained KVM0-B offline import, contract, report, and rejection graph.
# The checked launcher is the normative entry point. This Makefile accepts one
# authenticated goal, uses only absolute host tools, performs no network or
# target access, and confines every generated byte to build/kvm0.

override KVM0_CALLER_SHELL_ORIGIN := $(origin SHELL)
override KVM0_CALLER_SHELLFLAGS_ORIGIN := $(origin .SHELLFLAGS)
override SHELL := /usr/bin/bash
override .SHELLFLAGS := -eu -o pipefail -c
override KVM0_PACKAGE := $(abspath .)
override KVM0_MAKEFILE := $(KVM0_PACKAGE)/Makefile

ifneq ($(words $(MAKEFILE_LIST)),1)
$(error KVM0 rejects an additional or remade Makefile)
endif
ifneq ($(realpath $(firstword $(MAKEFILE_LIST))),$(realpath $(KVM0_MAKEFILE)))
$(error KVM0 requires the authenticated absolute tests/kvm0/Makefile)
endif
ifneq ($(strip $(MAKE_RESTARTS)),)
$(error KVM0 rejects Makefile restart/remaking)
endif
$(KVM0_MAKEFILE):: ;

ifneq ($(BE_KVM0_BOOTSTRAP_AUTHENTICATED),be-kvm0-checked-launcher-v1)
$(error KVM0 requires tests/kvm0/run-make.sh)
endif
override KVM0_PARSE_AUTH := $(shell /usr/bin/env -i PATH=/usr/bin \
	LC_ALL=C LANG=C HOME="$(abspath ../../build/kvm0/home)" \
	TMPDIR="$(abspath ../../build/kvm0/tmp)" \
	XDG_CACHE_HOME="$(abspath ../../build/kvm0/cache)" \
	BE_KVM0_BOOTSTRAP_AUTHENTICATED=be-kvm0-checked-launcher-v1 \
	/usr/bin/node check-contract.mjs --make-control 2>&1)
ifneq ($(KVM0_PARSE_AUTH),BE_KVM0_MAKE_CONTROL: PASS)
$(error KVM0 checked-launcher handoff failed: $(KVM0_PARSE_AUTH))
endif
ifneq ($(strip $(MAKEFILES)),)
$(error KVM0 rejects MAKEFILES injection)
endif
override KVM0_FLAG_TOKENS := $(MAKEFLAGS) $(GNUMAKEFLAGS) $(MFLAGS)
override KVM0_FLAG_WORDS := $(filter-out -%,$(KVM0_FLAG_TOKENS))
ifneq ($(filter -f% --file% --makefile% --eval% -e% -E% -I% --include-dir% \
	-o% --old-file% -W% --what-if% --assume-new% -i% --ignore-errors% \
	-k% --keep-going% -n% --dry-run% --just-print% --recon% -q% \
	--question% -t% --touch% --shuffle% -j% --jobs%,$(KVM0_FLAG_TOKENS)),)
$(error KVM0 rejects hostile Make control)
endif
ifneq ($(strip $(foreach letter,e f i j k n o q t E I W,$(findstring $(letter),$(KVM0_FLAG_WORDS)))),)
$(error KVM0 rejects hostile Make flag word)
endif
ifneq ($(filter command line environment environment override,$(KVM0_CALLER_SHELL_ORIGIN)),)
$(error KVM0 rejects caller SHELL)
endif
ifneq ($(filter command line environment environment override,$(KVM0_CALLER_SHELLFLAGS_ORIGIN)),)
$(error KVM0 rejects caller .SHELLFLAGS)
endif

override KVM0_ALLOWED_GOALS := kvm0-toolcheck kvm0-contract-check \
	kvm0-rejection-test kvm0-self-test kvm0-check kvm0-clean
ifneq ($(words $(MAKECMDGOALS)),1)
$(error KVM0 requires exactly one goal)
endif
ifneq ($(filter-out $(KVM0_ALLOWED_GOALS),$(MAKECMDGOALS)),)
$(error KVM0 rejects goal $(MAKECMDGOALS))
endif

override ROOT := ../..
override BUILD := $(ROOT)/build/kvm0
override NODE := /usr/bin/node
override PATH := /usr/bin
override LC_ALL := C
override LANG := C
override HOME := $(abspath $(BUILD)/home)
override TMPDIR := $(abspath $(BUILD)/tmp)
override XDG_CACHE_HOME := $(abspath $(BUILD)/cache)
export PATH LC_ALL LANG HOME TMPDIR XDG_CACHE_HOME
.NOTPARALLEL:
unexport BASH_ENV ENV LD_PRELOAD LD_LIBRARY_PATH NODE_OPTIONS NODE_PATH
unexport MAKEFILES MAKEOVERRIDES GNUMAKEFLAGS
unexport http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
unexport SSH_AUTH_SOCK SSH_AGENT_PID GIT_DIR GIT_WORK_TREE

override NODE_SOURCES := check-bundle.mjs check-contract.mjs check-report.mjs \
	generate-report.mjs test-rejections.mjs

.DEFAULT_GOAL := kvm0-toolcheck

.PHONY: kvm0-toolcheck kvm0-contract-check kvm0-rejection-test \
	kvm0-self-test kvm0-check kvm0-clean

kvm0-toolcheck:
	/usr/bin/bash -n run-make.sh
	@for source in $(NODE_SOURCES); do $(NODE) --check "$$source"; done
	$(NODE) check-contract.mjs --tools
	$(NODE) check-contract.mjs --sources
	@printf 'Beryllium KVM0-B tool boundary: PASS scope=offline node-builtins-only hardware=NOT-RUN\n'

kvm0-contract-check: kvm0-toolcheck
	$(NODE) check-contract.mjs

kvm0-self-test: kvm0-contract-check
	$(NODE) test-rejections.mjs --self-test

kvm0-rejection-test: kvm0-contract-check
	$(NODE) test-rejections.mjs --rejections

kvm0-check: kvm0-self-test kvm0-rejection-test
	@printf 'Beryllium KVM0-B offline package: PASS source-readiness=blocked hardware=NOT-RUN\n'

kvm0-clean:
	$(NODE) check-bundle.mjs --clean-build
	@printf 'Beryllium KVM0-B clean: PASS root=build/kvm0\n'
