diff --git a/include/sbi/sbi_dcommit.h b/include/sbi/sbi_dcommit.h
index 4063091..5047546 100644
--- a/include/sbi/sbi_dcommit.h
+++ b/include/sbi/sbi_dcommit.h
@@ -89,6 +89,49 @@ static inline bool sbi_dcommit_call_allowed(const struct sbi_dcommit_ecall *list
 /** Number of 32-bit cells in a configuration digest */
 #define SBI_DCOMMIT_DIGEST_CELLS	8
 
+/** Most non-root domains that may list a hart for its commit to be decided */
+#define SBI_DCOMMIT_VIEWS_MAX		3
+
+/** A non-root domain that lists the calling hart, as a commit sees it */
+struct sbi_dcommit_view {
+	/** Initialization order of the domain */
+	u32 order;
+	/** The calling hart runs in this domain */
+	bool caller;
+	/** The boot hart of the domain is the calling hart */
+	bool boots;
+	/** The domain has an SBI call allowlist */
+	bool listed;
+};
+
+/**
+ * Decide which domain, if any, the calling hart may commit to
+ *
+ * A hart may commit only from the non-root domain of least initialization
+ * order that lists it, to the one other non-root domain that lists it,
+ * and only when that domain names the hart as its boot hart and has an
+ * SBI call allowlist.
+ *
+ * @param v the non-root domains that list the calling hart
+ * @param n number of entries in v
+ *
+ * @return index in v of the domain to commit to, or -1 to refuse
+ */
+static inline int sbi_dcommit_target(const struct sbi_dcommit_view *v, u32 n)
+{
+	const struct sbi_dcommit_view *from, *to;
+
+	if (n != 2 || v[0].caller == v[1].caller)
+		return -1;
+
+	from = v[0].caller ? &v[0] : &v[1];
+	to = v[0].caller ? &v[1] : &v[0];
+	if (from->order >= to->order || !to->boots || !to->listed)
+		return -1;
+
+	return v[0].caller ? 1 : 0;
+}
+
 /** Table of commit records, indexed by hart index */
 extern struct sbi_dcommit_hart sbi_dcommit_harts[];
 
@@ -116,4 +159,32 @@ void sbi_dcommit_ecall_done(int ret);
  */
 void sbi_dcommit_set_digest(const u32 *cells);
 
+struct sbi_scratch;
+struct sbi_domain;
+
+/**
+ * Finish the memory protection of the current hart for a domain with an
+ * SBI call allowlist: make cache-block invalidation illegal below M-mode,
+ * check the PMP entries, and fill in the hart's commit record. Does
+ * nothing for a domain without an allowlist.
+ *
+ * @return 0 on success and negative error code on failure
+ */
+int sbi_dcommit_seal_hart(struct sbi_scratch *scratch, struct sbi_domain *dom);
+
+/**
+ * Move the calling hart to the domain chosen by sbi_dcommit_target()
+ *
+ * @return negative error code; does not return on success
+ */
+int sbi_dcommit_commit(void);
+
+/**
+ * Get one XLEN-wide word of the configuration digest, most significant
+ * word first
+ *
+ * @return 0 on success and negative error code on failure
+ */
+int sbi_dcommit_digest_word(unsigned long index, unsigned long *word);
+
 #endif
diff --git a/include/sbi/sbi_ecall_interface.h b/include/sbi/sbi_ecall_interface.h
index fd4e77c..395e61b 100644
--- a/include/sbi/sbi_ecall_interface.h
+++ b/include/sbi/sbi_ecall_interface.h
@@ -498,6 +498,11 @@ enum sbi_sse_state {
 #define SBI_SPEC_VERSION_MINOR_MASK		0xffffff
 #define SBI_EXT_EXPERIMENTAL_START		0x08000000
 #define SBI_EXT_EXPERIMENTAL_END		0x08FFFFFF
+
+/* Experimental domain commit extension and its function IDs */
+#define SBI_EXT_DCOMMIT				0x08004246
+#define SBI_EXT_DCOMMIT_COMMIT			0x0
+#define SBI_EXT_DCOMMIT_DIGEST			0x1
 #define SBI_EXT_VENDOR_START			0x09000000
 #define SBI_EXT_VENDOR_END			0x09FFFFFF
 #define SBI_EXT_FIRMWARE_START			0x0A000000
diff --git a/lib/sbi/Kconfig b/lib/sbi/Kconfig
index 24132ea..fb60a0b 100644
--- a/lib/sbi/Kconfig
+++ b/lib/sbi/Kconfig
@@ -95,4 +95,13 @@ config SBI_ECALL_SSE
 config SBI_ECALL_MPXY
 	bool "MPXY extension"
 	default y
+
+config SBI_ECALL_DCOMMIT
+	bool "Domain commit extension (experimental)"
+	default n
+	help
+	  Let a hart move once, from the domain it boots in, to a domain
+	  that names it as its boot hart and filters its SBI calls with an
+	  allowlist, and serve the configuration digest read from the
+	  device tree.
 endmenu
