diff --git a/lib/sbi/sbi_dcommit.c b/lib/sbi/sbi_dcommit.c
index bc4bf03..5502f43 100644
--- a/lib/sbi/sbi_dcommit.c
+++ b/lib/sbi/sbi_dcommit.c
@@ -4,14 +4,22 @@
  * Copyright (c) 2026 James Morris <jmorris@namei.org>
  */
 
+#include <sbi/riscv_asm.h>
 #include <sbi/riscv_encoding.h>
 #include <sbi/sbi_console.h>
 #include <sbi/sbi_dcommit.h>
 #include <sbi/sbi_domain.h>
+#include <sbi/sbi_domain_context.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_hart.h>
+#include <sbi/sbi_hart_pmp.h>
 #include <sbi/sbi_hartmask.h>
 #include <sbi/sbi_scratch.h>
 #include <sbi/sbi_trap.h>
 
+/* Bound on the domains walked to decide a commit */
+#define DCOMMIT_WALK_MAX	64
+
 struct sbi_dcommit_hart sbi_dcommit_harts[SBI_HARTMASK_MAX_BITS];
 
 /* Six counters and registers, the configuration bytes, the addresses */
@@ -69,3 +77,102 @@ void sbi_dcommit_set_digest(const u32 *cells)
 	sbi_printf("\n");
 	dcommit_digest_set = true;
 }
+
+int sbi_dcommit_seal_hart(struct sbi_scratch *scratch, struct sbi_domain *dom)
+{
+	struct sbi_dcommit_hart *rec = dcommit_thishart();
+	bool has_menvcfg;
+	int rc;
+
+	if (!dom || !dom->ecall_filtered)
+		return 0;
+
+	/* Make cache-block invalidation illegal below M-mode */
+	has_menvcfg = sbi_hart_priv_version(scratch) >= SBI_HART_PRIV_VER_1_12;
+	if (has_menvcfg)
+		csr_clear(CSR_MENVCFG, ENVCFG_CBIE);
+
+	rc = sbi_hart_pmp_verify(scratch, dom, rec->pmpcfg, rec->pmpaddr,
+				 SBI_DCOMMIT_PMP_ENTRIES);
+	if (rc) {
+		sbi_printf("%s: hart%u PMP does not match domain %s\n",
+			   __func__, current_hartid(), dom->name);
+		return rc;
+	}
+
+	rec->menvcfg = has_menvcfg ? csr_read64(CSR_MENVCFG) : 0;
+	rec->mseccfg = sbi_hart_has_extension(scratch, SBI_HART_EXT_SMEPMP) ?
+		       csr_read64(CSR_MSECCFG) : 0;
+	rec->committed = 1;
+
+	return 0;
+}
+
+int sbi_dcommit_commit(void)
+{
+	struct sbi_dcommit_view views[SBI_DCOMMIT_VIEWS_MAX];
+	struct sbi_domain *cur = sbi_domain_thishart_ptr();
+	u32 hartindex = current_hartindex();
+	u32 hartid = current_hartid();
+	u32 n = 0, walked = 0;
+	struct sbi_domain *dom;
+
+	sbi_domain_for_each(dom) {
+		if (++walked > DCOMMIT_WALK_MAX)
+			return SBI_EDENIED;
+		if (dom == &root ||
+		    !sbi_hartmask_test_hartindex(hartindex, dom->possible_harts))
+			continue;
+		if (n == SBI_DCOMMIT_VIEWS_MAX)
+			return SBI_EDENIED;
+		views[n].order = dom->init_order;
+		views[n].caller = dom == cur;
+		views[n].boots = dom->boot_hartid == hartid;
+		views[n].listed = dom->ecall_filtered;
+		n++;
+	}
+
+	if (sbi_dcommit_target(views, n) < 0)
+		return SBI_EDENIED;
+
+	/*
+	 * Leaving a domain whose context has no caller to return to enters
+	 * the domain of least initialization order, other than the current
+	 * one, that lists this hart and has not run on it. That is the
+	 * domain chosen above: root comes after every other domain, and no
+	 * other domain lists the hart. Entering it does not return.
+	 */
+	if (sbi_domain_context_exit())
+		return SBI_EFAIL;
+
+	/*
+	 * A return without an error would mean that the target had run on
+	 * this hart before, and that the trap frame of this call now holds
+	 * that context: the hart must not go back through it.
+	 */
+	sbi_printf("%s: hart%u returned from a domain switch\n", __func__,
+		   hartid);
+	sbi_hart_hang();
+}
+
+int sbi_dcommit_digest_word(unsigned long index, unsigned long *word)
+{
+	const struct sbi_domain *dom = sbi_domain_thishart_ptr();
+	unsigned long cells = sizeof(unsigned long) / sizeof(u32);
+
+	if (!dcommit_digest_set)
+		return SBI_ENOTSUPP;
+	if (!dom || dom == &root || dom->ecall_filtered)
+		return SBI_EDENIED;
+	if (index >= SBI_DCOMMIT_DIGEST_CELLS / cells)
+		return SBI_EINVAL;
+
+#if __riscv_xlen == 64
+	*word = ((unsigned long)dcommit_digest[2 * index] << 32) |
+		dcommit_digest[2 * index + 1];
+#else
+	*word = dcommit_digest[index];
+#endif
+
+	return 0;
+}
diff --git a/lib/sbi/sbi_ecall_dcommit.c b/lib/sbi/sbi_ecall_dcommit.c
new file mode 100644
index 0000000..03e85a7
--- /dev/null
+++ b/lib/sbi/sbi_ecall_dcommit.c
@@ -0,0 +1,41 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 James Morris <jmorris@namei.org>
+ */
+
+#include <sbi/sbi_dcommit.h>
+#include <sbi/sbi_ecall.h>
+#include <sbi/sbi_ecall_interface.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_trap.h>
+
+static int sbi_ecall_dcommit_handler(unsigned long extid, unsigned long funcid,
+				     struct sbi_trap_regs *regs,
+				     struct sbi_ecall_return *out)
+{
+	switch (funcid) {
+	case SBI_EXT_DCOMMIT_COMMIT:
+		return sbi_dcommit_commit();
+	case SBI_EXT_DCOMMIT_DIGEST:
+		return sbi_dcommit_digest_word(regs->a0, &out->value);
+	default:
+		return SBI_ENOTSUPP;
+	}
+}
+
+struct sbi_ecall_extension ecall_dcommit;
+
+static int sbi_ecall_dcommit_register_extensions(void)
+{
+	return sbi_ecall_register_extension(&ecall_dcommit);
+}
+
+struct sbi_ecall_extension ecall_dcommit = {
+	.name			= "dcommit",
+	.extid_start		= SBI_EXT_DCOMMIT,
+	.extid_end		= SBI_EXT_DCOMMIT,
+	.experimental		= true,
+	.register_extensions	= sbi_ecall_dcommit_register_extensions,
+	.handle			= sbi_ecall_dcommit_handler,
+};
