diff --git a/lib/sbi/sbi_dcommit.c b/lib/sbi/sbi_dcommit.c
new file mode 100644
index 0000000..b8538cf
--- /dev/null
+++ b/lib/sbi/sbi_dcommit.c
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 James Morris <jmorris@namei.org>
+ */
+
+#include <sbi/riscv_encoding.h>
+#include <sbi/sbi_dcommit.h>
+#include <sbi/sbi_hartmask.h>
+#include <sbi/sbi_scratch.h>
+
+struct sbi_dcommit_hart sbi_dcommit_harts[SBI_HARTMASK_MAX_BITS];
+
+/* Six counters and registers, the configuration bytes, the addresses */
+_Static_assert(sizeof(struct sbi_dcommit_hart) ==
+	       6 * sizeof(u64) + SBI_DCOMMIT_PMP_ENTRIES * (1 + sizeof(u64)),
+	       "struct sbi_dcommit_hart must have no padding");
+
+static struct sbi_dcommit_hart *dcommit_thishart(void)
+{
+	return &sbi_dcommit_harts[current_hartindex()];
+}
+
+void sbi_dcommit_trap_redirected(unsigned long cause)
+{
+	if (cause == CAUSE_FETCH_ACCESS || cause == CAUSE_LOAD_ACCESS ||
+	    cause == CAUSE_STORE_ACCESS)
+		dcommit_thishart()->pmp_faults++;
+}
diff --git a/lib/sbi/sbi_trap.c b/lib/sbi/sbi_trap.c
index e694188..42584cc 100644
--- a/lib/sbi/sbi_trap.c
+++ b/lib/sbi/sbi_trap.c
@@ -11,6 +11,7 @@
 #include <sbi/riscv_encoding.h>
 #include <sbi/sbi_bitops.h>
 #include <sbi/sbi_console.h>
+#include <sbi/sbi_dcommit.h>
 #include <sbi/sbi_double_trap.h>
 #include <sbi/sbi_ecall.h>
 #include <sbi/sbi_error.h>
@@ -115,6 +116,8 @@ int sbi_trap_redirect(struct sbi_trap_regs *regs,
 	if (prev_mode != PRV_S && prev_mode != PRV_U)
 		return SBI_ENOTSUPP;
 
+	sbi_dcommit_trap_redirected(trap->cause);
+
 	/* If hart support for zicfilp, clear MPELP because redirecting to VS or (H)S */
 	if (sbi_hart_has_extension(sbi_scratch_thishart_ptr(), SBI_HART_EXT_ZICFILP)) {
 #if __riscv_xlen == 32
