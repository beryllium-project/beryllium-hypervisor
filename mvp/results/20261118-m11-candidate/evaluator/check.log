set -e; for guest in 0 1; do \
	case $guest in 0) dtb=<repo>/build/mvp/guest/mvp-guest-g0-reference.dtb ;; *) dtb=<repo>/build/mvp/guest/mvp-guest-g1-reference.dtb ;; esac; \
	QEMU='/usr/bin/qemu-system-riscv64' PYTHON='/usr/bin/python3' \
		<repo>/mvp/tools/run-reference-boot.sh $guest \
		<repo>/build/mvp/guest/Image $dtb <repo>/build/mvp/guest/ref-stub.elf <repo>/build/mvp/firmware/platform/generic/firmware/fw_dynamic.bin \
		<repo>/mvp/guest/pins.txt <repo>/build/mvp/guest/reference-boot/g$guest; \
done
