mkdir -p <repo>/build/mvp/guest
set -e; kernel=$(/usr/bin/python3 -B <repo>/mvp/tools/gen-dts.py --layout <repo>/mvp/src/mvp-layout.h  --query reference-kernel); \
dtb=$(/usr/bin/python3 -B <repo>/mvp/tools/gen-dts.py --layout <repo>/mvp/src/mvp-layout.h  --query reference-dtb); \
riscv64-linux-gnu-gcc -march=rv64imac_zicsr -mabi=lp64 -nostdlib \
	-nostartfiles -static -no-pie -DMVP_REF_KERNEL=$kernel \
	-DMVP_REF_DTB=$dtb -Wl,-Ttext=0x80100000 -Wl,-e,_start \
	-Wl,-n -Wl,--build-id=none -Wl,--no-relax -Wl,--fatal-warnings \
	-o <repo>/build/mvp/guest/ref-stub.elf <repo>/mvp/guest/ref-stub.S
# QEMU enters an ELF -kernel at its lowest PT_LOAD address, so -n keeps
# the ELF headers out of the one segment, which must start at _start.
test "$(riscv64-linux-gnu-readelf -lW <repo>/build/mvp/guest/ref-stub.elf | awk '$1 == "LOAD" { print $3 }')" = \
	"0x$(printf '%016x' 0x80100000)"
