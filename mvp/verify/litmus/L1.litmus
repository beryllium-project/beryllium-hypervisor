(* Premise L1: "the barrier: a domain hart that reads the published
   generation word reads every block word hart 0 wrote before its
   `fence w, w`" (planning/mvp-m8-plan.md, D-3 and D-9), the premise of
   P1, barrier_publication (planning/mvp-m8-specifications.md, sections 1
   and 3, specification SHA-256
   ade32fa639d255ec2ba08040bbe8dbba2d7d8bf3fc4401947f4c542ecc9dc53d).
   Message passing with fence w,w and fence r,r, as the two toolchains
   compiled it in build/mvp/gcc/be-mvp.elf and build/mvp/clang/be-mvp.elf
   (the lines in mvp/verify/litmus/sequences/SYMBOL-TOOLCHAIN.s; GCC's
   address, then Clang's):
   P0, hart 0 in publish_blocks (GCC inlines it in be_mvp_runtime_main):
     sd x6,0(x10)    desc->hart, be_mvp_block_fill      102079072 1020790be
     sd x7,0(x11)    desc->hgatp, be_mvp_block_fill     102079080 1020790c6
     fence w,w       be_mvp_arch_fence_w_w, through be_mvp_exec_fence_w_w,
                     called at                          10207b402 10207b534
     sd x8,0(x12)    the generation word, 1             10207b40c 10207b540
   P1, the domain hart in be_mvp_hart_main:
     ld x5,0(x12)    the generation word                1020705f2 1020703ec
     bne x5,x9,LC00  not 1: the hart parks              1020705f6 1020703f2
     fence r,r       be_mvp_arch_fence_r_r, through be_mvp_exec_fence_r_r,
                     called at                          1020705fe 1020703fa
     ld x6,0(x10)    desc->hart, be_mvp_block_check     1020716a8 1020718da
     ld x7,0(x11)    desc->hgatp, for the one install   102070690 102070476
   Every other word hart 0 publishes (the cleared state page, the rest of
   the descriptor, the entry frame, the walked map and leaves, the ring
   views) is stored before the same fence, and every other word the domain
   hart checks is loaded after its own, but one: since M11-3 the hart
   first compares the published page's address in its own page with the
   address that it computes itself, and parks if they differ, so that
   load only adds ways to park. Two of each stand for them. A reduced test
   keeps fewer accesses and orderings than the code, so it allows at least
   the code's outcomes: Never here is Never there. Domain 1's generation
   word is stored after the fence too.
   Forbidden: the domain hart reads generation 1 with an old (zero)
   descriptor word.
   Digests (mvp/verify/litmus/sequences.txt):
   be_mvp_block_fill@gcc sha256=bfeb1bbdb541651725c52f6f7a1e5ba87724b61314f19707f036f8ac454ccf94
   be_mvp_block_fill@clang sha256=4e25dc0546c290174045e7d1db63cadcc5c1de83af40f8850d2638a95da12985
   be_mvp_runtime_main@gcc sha256=5b610b92f18e362927b8068ece0a9ae7ae60c9625543ec0b30cb81da3fe06d6f
   publish_blocks@clang sha256=979a529c0aaf27689d3358b66347c5607ebcbf8cbb73fbed3ec07cf579203654
   be_mvp_exec_fence_w_w@gcc sha256=474e4d5a697a0e3f4f1068e2a0489498d6ae509f161a5df319696b3f6ab83478
   be_mvp_exec_fence_w_w@clang sha256=b075360f5073e1d04a754811ed6cc0f22f7847cd780615f54f2cedff41973a20
   be_mvp_arch_fence_w_w@gcc sha256=4a9c49b5aeb97cd559e75906fa16144d0b05bd33affb259ae823429b7fb89d2b
   be_mvp_arch_fence_w_w@clang sha256=4a9c49b5aeb97cd559e75906fa16144d0b05bd33affb259ae823429b7fb89d2b
   be_mvp_hart_main@gcc sha256=6faa7daa6687112b8b76f28deb4048a09801fc8e682b36484dcf390d6da5d5a1
   be_mvp_hart_main@clang sha256=7e5c2e9613f80b09a19ad3bafcbf1da8dada91820194ce55184b3184f092d690
   be_mvp_exec_fence_r_r@gcc sha256=474e4d5a697a0e3f4f1068e2a0489498d6ae509f161a5df319696b3f6ab83478
   be_mvp_exec_fence_r_r@clang sha256=b075360f5073e1d04a754811ed6cc0f22f7847cd780615f54f2cedff41973a20
   be_mvp_arch_fence_r_r@gcc sha256=a173287af103bb3df9e7a542c380e51560c7777708cf7ac49430094df5ce713b
   be_mvp_arch_fence_r_r@clang sha256=a173287af103bb3df9e7a542c380e51560c7777708cf7ac49430094df5ce713b
   be_mvp_block_check@gcc sha256=a32ea6981ed47836f31f124e9046bf7e4780f3408288729706cd68489ac15fcd
   be_mvp_block_check@clang sha256=853f181ff06e91ef60dbfe9055ff87ff5c79f958a8dcfba97d9a40040c041e4b *)
{
desc_hart=0; desc_hgatp=0; generation=0;
0:x10=desc_hart; 0:x11=desc_hgatp; 0:x12=generation;
0:x6=1; 0:x7=2; 0:x8=1;
1:x10=desc_hart; 1:x11=desc_hgatp; 1:x12=generation; 1:x9=1;
}
 P0           | P1             ;
 sd x6,0(x10) | ld x5,0(x12)   ;
 sd x7,0(x11) | bne x5,x9,LC00 ;
 fence w,w    | fence r,r      ;
 sd x8,0(x12) | ld x6,0(x10)   ;
              | ld x7,0(x11)   ;
              | LC00:          ;
exists (1:x5=1 /\ (1:x6=0 \/ 1:x7=0))
