1:x10=type_byte; 1:x11=head;
}
 P0           | P1            ;
 sb x6,0(x10) | ld x5,0(x11)  ;
 fence w,w    | fence r,r     ;
 sd x7,0(x11) | lbu x6,0(x10) ;
exists (1:x5=120 /\ 1:x6=0)
