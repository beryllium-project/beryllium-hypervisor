(* Purpose: herd7 qualification under riscv.cat (planning/mvp-m8-plan.md,
   D-7 item 2, D-9), vacuity: the fenced test's sequentially consistent
   outcome (both new values) is allowed (Sometimes), so a claim that it
   never happens must not prove: the model does not forbid everything.
   Specification SHA-256
   ade32fa639d255ec2ba08040bbe8dbba2d7d8bf3fc4401947f4c542ecc9dc53d. *)
"Fence.w.wdWW Rfe Fence.r.rdRR Fre"
{
0:x5=x; 0:x6=y;
1:x5=y; 1:x6=x;
}
 P0          | P1          ;
 ori x7,x0,1 | lw x7,0(x5) ;
 sw x7,0(x5) | fence r,r   ;
 fence w,w   | lw x8,0(x6) ;
 ori x8,x0,1 |             ;
 sw x8,0(x6) |             ;
exists (1:x7=1 /\ 1:x8=1)
