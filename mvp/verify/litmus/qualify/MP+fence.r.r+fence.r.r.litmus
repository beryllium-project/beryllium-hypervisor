RISCV MP+fence.r.r+fence.r.r
(* SPDX-License-Identifier: GPL-3.0-only *)
(* Copyright (C) 2026 James Morris <jamorris@linux.microsoft.com> *)
(* Purpose: herd7 qualification under riscv.cat (planning/mvp-m8-plan.md,
   D-7 item 2, D-9), wrong-implementation: the writer's fence w,w replaced
   by fence r,r, which does not order its two stores; the forbidden outcome
   reappears (Sometimes). Specification SHA-256
   ade32fa639d255ec2ba08040bbe8dbba2d7d8bf3fc4401947f4c542ecc9dc53d. *)
"Fence.r.rdWW Rfe Fence.r.rdRR Fre"
{
0:x5=x; 0:x6=y;
1:x5=y; 1:x6=x;
}
 P0          | P1          ;
 ori x7,x0,1 | lw x7,0(x5) ;
 sw x7,0(x5) | fence r,r   ;
 fence r,r   | lw x8,0(x6) ;
 ori x8,x0,1 |             ;
 sw x8,0(x6) |             ;
exists (1:x7=1 /\ 1:x8=0)
