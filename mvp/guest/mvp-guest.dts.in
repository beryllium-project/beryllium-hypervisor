//
// The MVP guest device tree (planning/mvp-m0-plan.md, Guest software, Q3):
// B6's tree (planning/k3-b6-plan.md, Device tree) with the MVP model and
// compatible. One hart with its interrupt controller, the timebase, and one
// memory node, and no other device. tools/gen-dts.py fills each
// placeholder from src/mvp-layout.h, the guest, and the selected variant,
// so G0's and G1's DTBs differ only in bootargs; the pinned kernel tree's
// own dtc compiles each with -S 4096. The guest's hart is 0 in every DTB,
// whatever physical hart runs its domain.
/dts-v1/;

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "beryllium,mvp-guest";
	model = "Beryllium MVP guest";

	chosen {
		bootargs = "${BOOTARGS}";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <${TIMEBASE_HZ}>;

		cpu@0 {
			device_type = "cpu";
			reg = <0>;
			compatible = "riscv";
			mmu-type = "riscv,sv39";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = ${ISA_EXTENSIONS};

			interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};
	};

	memory@${MEMORY_UNIT} {
		device_type = "memory";
		reg = <${MEMORY_REG}>;
	};
};
