#
# The MVP guest kernel's own Kconfig fragment. tools/build-guest.sh merges
# it after B6's unchanged fragment and requires every value below in the
# final .config, and each of B6's but CONFIG_MODULES, which this fragment
# sets in its place.
#
# M1 (planning/mvp-m1-plan.md, Q2 and Guest software): /dev/mem, with
# STRICT_DEVMEM's filter, which refuses the guest's own RAM and allows every
# other address (lib/devmem_is_allowed.c:21-28@v7.2), so the init can map
# the channel page and its denied addresses and nothing of its RAM. The
# build stops (stop condition 5) unless M1's .config, from B6's fragment and
# these two lines, differs from the one B6's fragment alone gives in exactly
# these two lines and IO_STRICT_DEVMEM's "is not set" line, which
# STRICT_DEVMEM makes visible.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# M2 (planning/mvp-m2-plan.md, Q2 and Q16): loadable modules, for the init
# to load the management module (guest/mgmt/be-mgmt.c) with finit_module;
# MODULE_UNLOAD, MODVERSIONS, MODULE_SIG, and MODULE_COMPRESS stay off, as
# allnoconfig leaves them. The build stops (stop condition 5) unless the
# final .config differs from M1's in exactly these sixteen lines, measured
# at M2-4: CONFIG_MODULES=y and the lines it makes visible, among them
# EXECMEM, which MODULES selects, and DRIVER_DEFERRED_PROBE_TIMEOUT, whose
# default is 10 with MODULES and 0 without (drivers/base/Kconfig@v7.2).
# tools/build-guest.sh checks this list against its own.
#   # CONFIG_MODULE_ALLOW_MISSING_NAMESPACE_IMPORTS is not set
#   # CONFIG_MODULE_COMPRESS is not set
#   # CONFIG_MODULE_FORCE_LOAD is not set
#   # CONFIG_MODULE_SIG is not set
#   # CONFIG_MODULE_SRCVERSION_ALL is not set
#   # CONFIG_MODULE_UNLOAD is not set
#   # CONFIG_MODVERSIONS is not set
#   # CONFIG_STRICT_MODULE_RWX is not set
#   # CONFIG_TEST_ASYNC_DRIVER_PROBE is not set
#   # CONFIG_TEST_LOCKUP is not set
#   # CONFIG_TRIM_UNUSED_KSYMS is not set
#   CONFIG_DRIVER_DEFERRED_PROBE_TIMEOUT=10
#   CONFIG_EXECMEM=y
#   CONFIG_MODPROBE_PATH="/sbin/modprobe"
#   CONFIG_MODULES=y
#   CONFIG_MODULES_USE_ELF_RELA=y
CONFIG_MODULES=y
