#
# The MVP guest kernel's own Kconfig fragment. tools/build-guest.sh merges
# it after B6's unchanged fragment and requires every value below in the
# final .config, and each of B6's but CONFIG_MODULES, which this fragment
# sets in its place.
#
# M1 (planning/mvp-m1-plan.md, Q2 and Guest software): /dev/mem, with
# STRICT_DEVMEM's filter, which refuses the guest's own RAM and allows every
# other address (lib/devmem_is_allowed.c:21-28@v7.2), so the init can map
# the channel page and its denied addresses and nothing of its RAM. The
# build stops (stop condition 5) unless M1's .config, from B6's fragment and
# these two lines, differs from the one B6's fragment alone gives in exactly
# these two lines and IO_STRICT_DEVMEM's "is not set" line, which
# STRICT_DEVMEM makes visible.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# M2 (planning/mvp-m2-plan.md, Q2 and Q16): loadable modules, for the init
# to load the management module (guest/mgmt/be-mgmt.c) with finit_module;
# MODULE_UNLOAD, MODVERSIONS, MODULE_SIG, and MODULE_COMPRESS stay off, as
# allnoconfig leaves them. The build stops (stop condition 5) unless M2's
# .config (the final one until the /proc line below) differs from M1's in
# exactly these sixteen lines, measured at M2-4: CONFIG_MODULES=y and the
# lines it makes visible, among them EXECMEM, which MODULES selects, and
# DRIVER_DEFERRED_PROBE_TIMEOUT, whose default is 10 with MODULES and 0
# without (drivers/base/Kconfig@v7.2). tools/build-guest.sh checks this
# list against its own.
#   # CONFIG_MODULE_ALLOW_MISSING_NAMESPACE_IMPORTS is not set
#   # CONFIG_MODULE_COMPRESS is not set
#   # CONFIG_MODULE_FORCE_LOAD is not set
#   # CONFIG_MODULE_SIG is not set
#   # CONFIG_MODULE_SRCVERSION_ALL is not set
#   # CONFIG_MODULE_UNLOAD is not set
#   # CONFIG_MODVERSIONS is not set
#   # CONFIG_STRICT_MODULE_RWX is not set
#   # CONFIG_TEST_ASYNC_DRIVER_PROBE is not set
#   # CONFIG_TEST_LOCKUP is not set
#   # CONFIG_TRIM_UNUSED_KSYMS is not set
#   CONFIG_DRIVER_DEFERRED_PROBE_TIMEOUT=10
#   CONFIG_EXECMEM=y
#   CONFIG_MODPROBE_PATH="/sbin/modprobe"
#   CONFIG_MODULES=y
#   CONFIG_MODULES_USE_ELF_RELA=y
CONFIG_MODULES=y
# The guest's /proc (the responsible human's direction of 2026-11-06, "also,
# can we get /proc mounted in the guest?", with the form answers
# placement=branch and automount=true; mvp/README.md, open item 130):
# procfs, which /init-shell mounts at /proc before it starts the shell
# (guest/mvp-init.c) and which BusyBox's mount, umount, and ps read
# (guest/busybox.config). PROC_FS depends on nothing, but tinyconfig's
# EXPERT makes its prompt visible, so allnoconfig leaves it off unless this
# line sets it; every option it makes visible stays off, as allnoconfig
# leaves it, /proc/sys (PROC_SYSCTL), /proc/kcore, and the page monitor
# among them. The build stops (stop condition 5 of the M1 and M2 plans,
# applied to this step) unless the final .config differs from M2's, made
# from this fragment without this line, in exactly these ten lines,
# measured on 2026-11-06. tools/build-guest.sh checks this list against
# its own.
#   # CONFIG_CHECKPOINT_RESTORE is not set
#   # CONFIG_DYNAMIC_DEBUG is not set
#   # CONFIG_DYNAMIC_DEBUG_CORE is not set
#   # CONFIG_MEM_ALLOC_PROFILING is not set
#   # CONFIG_PROC_CHILDREN is not set
#   # CONFIG_PROC_KCORE is not set
#   # CONFIG_PROC_PAGE_MONITOR is not set
#   # CONFIG_PROC_SYSCTL is not set
#   # CONFIG_SCHEDSTATS is not set
#   CONFIG_PROC_FS=y
CONFIG_PROC_FS=y
